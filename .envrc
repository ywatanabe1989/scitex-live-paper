# scitex-live-paper → its own Telegram bot (CCT_BOT_TOKEN_LIVE_PAPER).
# sac folds at deploy; direnv applies live. Unique per project — no 409 combat.
# CCT_BOT_TOKEN resolves to a REAL token only when the launching shell has
# $CCT_BOT_TOKEN_LIVE_PAPER loaded (operator secrets-sourced shell); a
# daemon/bypass restart folds it EMPTY — restart from the host shell.
export CCT_AGENT_ID="scitex-live-paper"
export CCT_BOT_TOKEN="$CCT_BOT_TOKEN_LIVE_PAPER"


# SciTeX Todo
export SCITEX_TODO_AGENT_ID="scitex-live-paper"
